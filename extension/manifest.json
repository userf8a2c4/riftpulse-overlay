{
  "manifest_version": 3,
  "name": "RiftPulse",
  "version": "2.0",
  "description": "Panel lateral y overlay de RiftPulse para el Mundial. Se actualiza solo desde la web.",
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen",
    "userScripts",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://esports-api.lolesports.com/*",
    "https://feed.lolesports.com/*",
    "https://ddragon.leagueoflegends.com/*",
    "https://static.lolesports.com/*",
    "https://userf8a2c4.github.io/*",
    "*://*.twitch.tv/*",
    "*://*.lolesports.com/*"
  ],
  "action": {
    "default_title": "Abrir RiftPulse"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}