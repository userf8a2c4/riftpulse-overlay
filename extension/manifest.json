{
  "manifest_version": 3,
  "name": "RiftPulse",
  "version": "1.0",
  "description": "Panel lateral con predicciones, copa, historial y Pick'Em de Worlds 2026.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://esports-api.lolesports.com/*",
    "https://feed.lolesports.com/*",
    "https://ddragon.leagueoflegends.com/*",
    "https://static.lolesports.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*",
        "*://*.lolesports.com/*"
      ],
      "js": [
        "engine.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir RiftPulse"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}