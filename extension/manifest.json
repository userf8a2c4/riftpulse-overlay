{
  "manifest_version": 3,
  "name": "RiftPulse",
  "version": "0.9.2",
  "version_name": "0.9 beta",
  "description": "__MSG_desc__",
  "default_locale": "es",
  "permissions": [
    "sidePanel",
    "storage",
    "userScripts",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://esports-api.lolesports.com/*",
    "https://feed.lolesports.com/*",
    "https://ddragon.leagueoflegends.com/*",
    "https://static.lolesports.com/*",
    "https://userf8a2c4.github.io/*",
    "*://*.twitch.tv/*",
    "*://*.lolesports.com/*"
  ],
  "action": {
    "default_title": "__MSG_abrir__"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}